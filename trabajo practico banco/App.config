<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <connectionStrings>
        <!-- XAMPP local; cambia estos valores si tu servidor usa otra configuración. -->
        <add name="BancoMySql" providerName="MySql.Data.MySqlClient" connectionString="Server=127.0.0.1;Port=3306;Database=banco;Uid=root;Pwd=;"/>
    </connectionStrings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
    </startup>
</configuration>
